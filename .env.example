# Copy this file to .env in the repository root and replace every <PLACEHOLDER> with a real value.
# .env is git-ignored: never commit it. Docker Compose and the server both read it.
# The server won't start while a placeholder is left in place. For optional settings, delete the line
# instead to use the default named in its comment.

# --- Docker infrastructure (compose.yaml) ---
# Database user and database name, for example aperture.
POSTGRES_USER=<POSTGRES_USER>
POSTGRES_DB=<POSTGRES_DB>
# Pick any password for the local database. Postgres reads it only when it first creates its volume.
POSTGRES_PASSWORD=<POSTGRES_PASSWORD>
# Host ports, normally 5432 for Postgres and 6379 for Redis.
POSTGRES_PORT=<POSTGRES_PORT>
REDIS_PORT=<REDIS_PORT>

# --- Server (apps/server) ---
# development, test or production. Optional, default development.
NODE_ENV=<NODE_ENV>
# Address the API binds to. Optional, default 127.0.0.1, which keeps it reachable from this machine only.
SERVER_HOST=<SERVER_HOST>
# API port. Optional, default 4100.
SERVER_PORT=<SERVER_PORT>
# fatal, error, warn, info, debug, trace or silent. Optional, default info.
LOG_LEVEL=<LOG_LEVEL>
# A postgres:// URL built from the Postgres user, password, port and database above, with host 127.0.0.1.
# If the server ever runs inside Docker, the host is the service name postgres instead.
DATABASE_URL=<DATABASE_URL>
# A redis:// URL with host 127.0.0.1 and the Redis port above (the service name redis inside Docker).
REDIS_URL=<REDIS_URL>

# --- Market data ---
# Which provider adapter to use. Only alpaca exists today. Optional, default alpaca.
MARKET_DATA_PROVIDER=<MARKET_DATA_PROVIDER>
# iex: free real-time feed from the IEX exchange only. sip: all US exchanges (paid plan).
# delayed_sip: all exchanges, 15 minutes late. Optional, default iex.
ALPACA_DATA_FEED=<ALPACA_DATA_FEED>
# Keys from the Alpaca dashboard; set both or neither. Delete both lines until you have an account.
ALPACA_API_KEY_ID=<ALPACA_API_KEY_ID>
ALPACA_API_SECRET_KEY=<ALPACA_API_SECRET_KEY>
