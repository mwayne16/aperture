{
  "name": "@aperture/shared",
  "private": true,
  "version": "0.0.0",
  "description": "Typed contracts shared by the Aperture desktop app and server.",
  "type": "module",
  "exports": {
    "./alertEngine": {
      "source": "./src/alertEngine.ts",
      "types": "./dist/alertEngine.d.ts",
      "default": "./dist/alertEngine.js"
    },
    "./alertRules": {
      "source": "./src/alertRules.ts",
      "types": "./dist/alertRules.d.ts",
      "default": "./dist/alertRules.js"
    },
    "./alerts": {
      "source": "./src/alerts.ts",
      "types": "./dist/alerts.d.ts",
      "default": "./dist/alerts.js"
    },
    "./chartRanges": {
      "source": "./src/chartRanges.ts",
      "types": "./dist/chartRanges.d.ts",
      "default": "./dist/chartRanges.js"
    },
    "./errors": {
      "source": "./src/errors.ts",
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./health": {
      "source": "./src/health.ts",
      "types": "./dist/health.d.ts",
      "default": "./dist/health.js"
    },
    "./instrumentSearch": {
      "source": "./src/instrumentSearch.ts",
      "types": "./dist/instrumentSearch.d.ts",
      "default": "./dist/instrumentSearch.js"
    },
    "./marketData": {
      "source": "./src/marketData.ts",
      "types": "./dist/marketData.d.ts",
      "default": "./dist/marketData.js"
    },
    "./news": {
      "source": "./src/news.ts",
      "types": "./dist/news.d.ts",
      "default": "./dist/news.js"
    },
    "./symbols": {
      "source": "./src/symbols.ts",
      "types": "./dist/symbols.d.ts",
      "default": "./dist/symbols.js"
    },
    "./watchlist": {
      "source": "./src/watchlist.ts",
      "types": "./dist/watchlist.d.ts",
      "default": "./dist/watchlist.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.build.json && tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "knip": "knip --no-progress",
    "check": "npm run typecheck && npm run lint && npm run knip && npm run test"
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "knip": "^6.45.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "dayjs": "^1.11.23"
  }
}
