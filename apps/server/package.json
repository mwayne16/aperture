{
  "name": "@aperture/server",
  "private": true,
  "version": "0.0.0",
  "description": "Aperture backend: market data, watchlist and alerts API.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "db:migrate": "tsc -b tsconfig.build.json && node scripts/typeorm.mjs migration:run",
    "db:revert": "tsc -b tsconfig.build.json && node scripts/typeorm.mjs migration:revert",
    "db:generate": "tsc -b tsconfig.build.json && node scripts/typeorm.mjs migration:generate --pretty",
    "typecheck": "tsc -b tsconfig.build.json && tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "knip": "knip --no-progress",
    "check": "npm run typecheck && npm run lint && npm run knip && npm run test"
  },
  "knip": {
    "entry": [
      "src/main.ts",
      "src/db/cliDataSource.ts",
      "scripts/*.mjs"
    ],
    "ignoreExportsUsedInFile": {
      "interface": true,
      "type": true
    }
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.1",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "knip": "^6.45.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@alpacahq/alpaca-trade-api": "^5.0.0",
    "@aperture/shared": "0.0.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.3"
  }
}
