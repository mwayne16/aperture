{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true,
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    // class-validator, class-transformer and (later) TypeORM use legacy decorators and design-type metadata.
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    // Decorated fields must stay plain assignments, not defined properties that shadow decorator behavior.
    "useDefineForClassFields": false,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "references": [{ "path": "../../packages/shared/tsconfig.build.json" }],
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/test"]
}
