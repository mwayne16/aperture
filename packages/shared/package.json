{
  "name": "@aperture/shared",
  "private": true,
  "version": "0.0.0",
  "description": "Typed contracts shared by the Aperture desktop app and server.",
  "type": "module",
  "exports": {
    "./errors": {
      "types": "./dist/errors.d.ts",
      "default": "./dist/errors.js"
    },
    "./health": {
      "types": "./dist/health.d.ts",
      "default": "./dist/health.js"
    }
  },
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc -b tsconfig.build.json && tsc -p tsconfig.json",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "knip": "knip --no-progress",
    "check": "npm run typecheck && npm run lint && npm run knip && npm run test"
  },
  "devDependencies": {
    "eslint": "^10.15.0",
    "knip": "^6.45.1",
    "typescript": "~6.0.3",
    "vitest": "^5.1.0"
  },
  "knip": {
    "entry": [
      "src/errors.ts",
      "src/health.ts"
    ]
  }
}
