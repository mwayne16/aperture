# Copy this file to .env in the repository root and fill it in. .env is git-ignored: never commit it.
# Docker Compose and the server both read it.

# --- Docker infrastructure (compose.yaml) ---
POSTGRES_USER=aperture
POSTGRES_PASSWORD=change-me
POSTGRES_DB=aperture
POSTGRES_PORT=5432
REDIS_PORT=6379

# --- Server (apps/server) ---
NODE_ENV=development
# Keep 127.0.0.1 so the API is only reachable from this machine.
SERVER_HOST=127.0.0.1
SERVER_PORT=4100
# fatal, error, warn, info, debug, trace or silent
LOG_LEVEL=info
# The server runs on the host and uses the ports above. If it ever runs inside Docker, use the service
# names instead: postgres://...@postgres:5432/... and redis://redis:6379.
DATABASE_URL=postgres://aperture:change-me@127.0.0.1:5432/aperture
REDIS_URL=redis://127.0.0.1:6379

# --- Market data ---
# Which provider adapter to use. Only alpaca exists today.
MARKET_DATA_PROVIDER=alpaca
# iex: free real-time feed from the IEX exchange only. sip: all US exchanges (paid plan).
# delayed_sip: all exchanges, 15 minutes late.
ALPACA_DATA_FEED=iex
# Keys from the Alpaca dashboard. Leave both empty until you have an account; set both or neither.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=
